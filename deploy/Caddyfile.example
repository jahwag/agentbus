{
	email ops@example.com
}

# Requires public DNS and inbound TCP 80/443. Replace the email and hostname.
# Fail visibly instead of redirecting a request that may already contain a
# bearer credential. AgentBus clients must still refuse remote plaintext HTTP.
http://agentbus.example.com {
	header -Server
	respond "HTTPS required" 426
}

https://agentbus.example.com {
	request_body {
		max_size 256KB
	}

	# The browser UI is an application-authenticated surface. Preserve its
	# public Host so AgentBus can enforce AGENTBUS_UI_PUBLIC_ORIGIN and complete
	# native OIDC callbacks. Configure native OIDC or trusted-edge assertion
	# verification before enabling this route.
	@ui path /ui /ui/*
	handle @ui {
		reverse_proxy 127.0.0.1:7777 {
			header_up Host {http.request.host}
		}
	}

	# Only agent traffic, the separately authenticated browser UI, and probes
	# are public. New daemon routes fail closed until an operator deliberately
	# adds them here; administrator inspection remains local-only.
	@public path /send /wait /ack /roster /mcp /mcp/* /.well-known/oauth-protected-resource/mcp /healthz /readyz
	handle @public {
		reverse_proxy 127.0.0.1:7777 {
			# Preserve the public Host. In OIDC-only deployments the daemon uses
			# it to keep unauthenticated REST local while the MCP verifier remains
			# independently available.
			header_up Host {http.request.host}
			transport http {
				response_header_timeout 5m10s
			}
		}
	}
	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
